POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://synqra:local-development-only@localhost:5432/synqra
REDIS_URL=redis://localhost:6379/0
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
STORAGE_PATH=./storage
# none, openai, or ollama. Never expose API keys through NEXT_PUBLIC variables.
AI_PROVIDER=none
CHAT_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=768
MODEL_SUPPORTS_STRUCTURED=false
MODEL_SUPPORTS_TOOLS=false
MAX_UPLOAD_MB=15
CHUNK_TOKENS=500
CHUNK_OVERLAP=80
CONTEXT_TOKENS=6000
MODEL_CONTEXT_TOKENS=16384
MAX_OUTPUT_TOKENS=2048
RETRIEVAL_K=6
SEMANTIC_CANDIDATES=30
KEYWORD_CANDIDATES=30
RERANK=false
SEED_PASSWORD=
# Leave false for ordinary use. The isolated tests/compose.yml enables it explicitly.
TEST_MODE=false
